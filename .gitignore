cat << 'EOF' > .gitignore
# Block test artifacts and trash binaries
*.aar
*.png
*.jpeg
*.jpg
*.mkv
secret.txt
backend/backend-sources.jar

# Block non-mobile frontend platforms entirely
frontend/macos/
frontend/linux/
frontend/windows/
frontend/web/

# Block Flutter build noise
frontend/.dart_tool/
frontend/.pub-cache/
frontend/.pub/
frontend/build/
EOF
